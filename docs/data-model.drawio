        <mxCell id="legend_text" value="PK &#8212; primary key&#10;FK &#8212; foreign key (italic)&#10;U &#8212; unique index&#10;CK &#8212; check constraint&#10;&#10;Crow foot on the many side, single bar on the one side.&#10;Dashed edge = nullable / optional relationship.&#10;&#10;Every FK is ON DELETE NO ACTION: a referenced row cannot&#10;be deleted while a child references it." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1072" y="566" width="320" height="136" as="geometry" />
        </mxCell>

        <mxCell id="fk_note" value="The schema is declared in two places that must agree:&#10;db/001_schema.sql (the source of truth &#8212; there are no EF migrations) and the&#10;EF Core model: columns, keys and indexes as data annotations on the entity&#10;classes, relationships as fluent config in NorthgateDbContext.OnModelCreating&#10;(HasOne / WithMany + HasConstraintName + OnDelete(DeleteBehavior.NoAction)).&#10;A catalog diff of both against a fresh DB reports 55 identical objects." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="460" height="100" as="geometry" />
