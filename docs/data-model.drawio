        <mxCell id="legend" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=12;" vertex="1" parent="1">
